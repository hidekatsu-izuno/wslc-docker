# Add selected exports to ~/.bashrc, or source a trusted copy manually.
# One executable path, not a shell command or command line.
# export WSLC_DOCKER_BIN='/mnt/c/Program Files/WSL/wslc.exe'

# Default: windows. Convert Ubuntu host paths with wslpath -w.
# export WSLC_DOCKER_PATH_MODE=windows

# Optional: separately installed Linux-native wslc Compose implementation.
# export WSLC_DOCKER_COMPOSE_BIN="$HOME/.local/bin/wslc-compose"
# wslc-compose also accepts WSLC_COMPOSE_BIN for its underlying wslc.exe.
# export WSLC_COMPOSE_BIN='/mnt/c/Program Files/WSL/wslc.exe'
